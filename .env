# ═══════════════════════════════════════════════════════════════
# Gemini API Keys — YouTube Automation Tool
# ═══════════════════════════════════════════════════════════════
#
# HOW TO ADD UP TO 10 KEYS:
#   Put all keys comma-separated in GEMINI_API_KEYS.
#   The tool automatically rotates to the next key when one hits
#   quota (429). Each key gets an independent 65-second cooldown
#   before it is retried. Zero downtime — fully automatic.
#
# FORMAT:
#   GEMINI_API_KEYS=AIzaSy...,AIzaSy...,AIzaSy...
#
# Get free keys: https://aistudio.google.com/app/apikey
# ═══════════════════════════════════════════════════════════════

GEMINI_API_KEYS="AIzaSyBiUK1sw6JIP1K8uE0Yn0p3TSl-hOK0tZk"

